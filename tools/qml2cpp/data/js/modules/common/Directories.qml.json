 "375c9de70238": {
  "cpp": "// Cleanup on init\nqs::Quickshell::instance().execDetached(std::vector<std::string>{\"mkdir\", \"-p\", shellConfig.get()});\nqs::Quickshell::instance().execDetached(std::vector<std::string>{\"mkdir\", \"-p\", favicons.get()});\nqs::Quickshell::instance().execDetached(\n    std::vector<std::string>{\"bash\", \"-c\", \"rm -rf '\" + coverArt.get() + \"'; mkdir -p '\" + coverArt.get() + \"'\"});\nqs::Quickshell::instance().execDetached(\n    std::vector<std::string>{\"bash\", \"-c\", \"rm -rf '\" + latexOutput.get() + \"'; mkdir -p '\" + latexOutput.get() + \"'\"});\nqs::Quickshell::instance().execDetached(\n    std::vector<std::string>{\"bash\", \"-c\", \"rm -rf '\" + cliphistDecode.get() + \"'; mkdir -p '\" + cliphistDecode.get() + \"'\"});\nqs::Quickshell::instance().execDetached(std::vector<std::string>{\"mkdir\", \"-p\", userActions.get()});\nqs::Quickshell::instance().execDetached(std::vector<std::string>{\"rm\", \"-rf\", tempImages.get()});",
  "kind": "statements (TemplateLiteral)",
  "context": "root.Component.onCompleted",
  "expected": "handler body, parameters ()",
  "code": "{\n        Quickshell.execDetached([\"mkdir\", \"-p\", `${shellConfig}`])\n        Quickshell.execDetached([\"mkdir\", \"-p\", `${favicons}`])\n        Quickshell.execDetached([\"bash\", \"-c\", `rm -rf '${coverArt}'; mkdir -p '${coverArt}'`])\n        Quickshell.execDetached([\"bash\", \"-c\", `rm -rf '${latexOutput}'; mkdir -p '${latexOutput}'`])\n        Quickshell.execDetached([\"bash\", \"-c\", `rm -rf '${cliphistDecode}'; mkdir -p '${cliphistDecode}'`])\n        Quickshell.execDetached([\"mkdir\", \"-p\", `${userActions}`])\n        Quickshell.execDetached([\"rm\", \"-rf\", `${tempImages}`])\n    }",
  "form": "body"
 },
