{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "arch",
    "padding": {
      "left": 1,
      "right": 2
    }
  },
  "display": {
    "separator": ""
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[34m╭─ \u001b[0m\u001b[1;34mHW\u001b[0m\u001b[34m ───────────────────────────────────────────────╮\u001b[0m"
    },
    {
      "type": "cpu",
      "key": "\u001b[34m│\u001b[0m \u001b[36m󰻠\u001b[0m CPU      \u001b[94G\u001b[34m│\u001b[0m\u001b[54G",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "key": "\u001b[34m│\u001b[0m \u001b[36m󰢮\u001b[0m GPU      \u001b[94G\u001b[34m│\u001b[0m\u001b[54G",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "\u001b[34m│\u001b[0m \u001b[36m󰍛\u001b[0m Memory   \u001b[94G\u001b[34m│\u001b[0m\u001b[54G",
      "format": "{used} / {total} ({percentage})"
    },
    {
      "type": "disk",
      "key": "\u001b[34m│\u001b[0m \u001b[36m󰋊\u001b[0m Disk     \u001b[94G\u001b[34m│\u001b[0m\u001b[54G",
      "format": "{size-used} / {size-total} ({size-percentage}) {filesystem}",
      "folders": "/"
    },
    {
      "type": "custom",
      "format": "\u001b[34m╰────────────────────────────────────────────────────╯\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[34m╭─ \u001b[0m\u001b[1;34mSYS\u001b[0m\u001b[34m ──────────────────────────────────────────────╮\u001b[0m"
    },
    {
      "type": "os",
      "key": "\u001b[34m│\u001b[0m \u001b[36m\u001b[0m OS       \u001b[94G\u001b[34m│\u001b[0m\u001b[54G",
      "format": "{pretty-name} {arch}"
    },
    {
      "type": "kernel",
      "key": "\u001b[34m│\u001b[0m \u001b[36m\u001b[0m Kernel   \u001b[94G\u001b[34m│\u001b[0m\u001b[54G",
      "format": "{release}"
    },
    {
      "type": "uptime",
      "key": "\u001b[34m│\u001b[0m \u001b[36m󰅐\u001b[0m Uptime   \u001b[94G\u001b[34m│\u001b[0m\u001b[54G"
    },
    {
      "type": "packages",
      "key": "\u001b[34m│\u001b[0m \u001b[36m󰏖\u001b[0m Pkgs     \u001b[94G\u001b[34m│\u001b[0m\u001b[54G"
    },
    {
      "type": "shell",
      "key": "\u001b[34m│\u001b[0m \u001b[36m\u001b[0m Shell    \u001b[94G\u001b[34m│\u001b[0m\u001b[54G",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "custom",
      "format": "\u001b[34m╰────────────────────────────────────────────────────╯\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[34m╭─ \u001b[0m\u001b[1;34mWM\u001b[0m\u001b[34m ───────────────────────────────────────────────╮\u001b[0m"
    },
    {
      "type": "wm",
      "key": "\u001b[34m│\u001b[0m \u001b[36m\u001b[0m WM       \u001b[94G\u001b[34m│\u001b[0m\u001b[54G",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "display",
      "key": "\u001b[34m│\u001b[0m \u001b[36m󰍹\u001b[0m Display  \u001b[94G\u001b[34m│\u001b[0m\u001b[54G",
      "format": "{width}x{height} @ {refresh-rate}Hz"
    },
    {
      "type": "terminal",
      "key": "\u001b[34m│\u001b[0m \u001b[36m\u001b[0m Term     \u001b[94G\u001b[34m│\u001b[0m\u001b[54G",
      "format": "{pretty-name}"
    },
    {
      "type": "terminalfont",
      "key": "\u001b[34m│\u001b[0m \u001b[36m\u001b[0m Font     \u001b[94G\u001b[34m│\u001b[0m\u001b[54G",
      "format": "{combined}"
    },
    {
      "type": "custom",
      "format": "\u001b[34m╰────────────────────────────────────────────────────╯\u001b[0m"
    }
  ]
}
